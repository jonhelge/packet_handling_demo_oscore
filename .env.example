# https://github.com/joncloud-dev/oscore-server/releases
OSCORE_SERVER_VERSION=0.1.0-preview.2

# openssl rand -hex 32 — keep stable; rotating orphans every device key.
PB_OSCORE_KEK=

PB_RETENTION_DAYS=90
HTTP_PORT=8090
COAP_PORT=5683

# Fly.io (scripts/fly-deploy.sh)
FLY_APP=
FLY_REGION=arn
FLY_ORG=

# PocketBase superuser (created on first deploy if set)
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# Optional public URL when not on Fly
PUBLIC_URL=
